# Analytics (mesma camada do app Forja — src/lib/track.ts — falando com o
# painel Codane Analytics). Sem estes três valores a camada fica DESLIGADA
# (nenhum evento é enviado).
# Eventos vão via POST JSON para <VITE_ANALYTICS_API_URL>/api/events
#   payload: { app_id, ingest_key, event, user_id, timestamp, platform, properties }
#
# Use o MESMO app_id e ingest_key do app Forja (supabase/registrar-apps.sql no
# repo codane-hub) — landing e app compartilham um único "aplicativo" no painel,
# para medir o funil completo (visita → clique em baixar → uso no app).
VITE_APP_ID=
VITE_ANALYTICS_API_URL=
VITE_ANALYTICS_INGEST_KEY=
